# ---- Next.js (Vercel) ----
# Anon key only. Both of these reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Pipeline (GitHub Actions secrets) ----
# The pipeline runs as the `pipeline_writer` Postgres role: insert and
# column-scoped update, no DELETE on any table. SUPABASE_ANON_KEY is only the
# gateway apiKey -- SUPABASE_PIPELINE_TOKEN is what carries the role.
#
# SUPABASE_PIPELINE_TOKEN is NOT the JWT secret. The secret is the signing key
# and can mint a token for any role, service_role included -- the token is one
# JWT signed by it, carrying {"role": "pipeline_writer"} and nothing more.
# Same species as the anon key, which is itself a JWT with {"role": "anon"}.
#
# Mint it locally, never in CI:
#   SUPABASE_JWT_SECRET=... python pipeline/mint_pipeline_token.py
#
# CI must never hold SUPABASE_JWT_SECRET: it can mint a service_role token,
# which bypasses RLS completely.
#
# Use the LEGACY anon key here (the long eyJhbGciOi... one), not the newer
# sb_publishable_... key -- the pipeline token is HS256-signed against the
# legacy JWT secret, so the two match generations. The Next.js vars above can
# keep using sb_publishable_.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PIPELINE_TOKEN=
OPENAI_API_KEY=

# ---- Admin sign-in (Supabase Dashboard > Authentication > Providers) ----
# GitHub OAuth. Callback URL: https://<your-domain>/auth/callback
# Being able to sign in grants nothing on its own -- admin is a row in
# public.user_roles, added by hand in the SQL editor.
